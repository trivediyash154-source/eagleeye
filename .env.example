# EAGLE EYE configuration — copy to .env and adjust. Safe placeholders only; never commit real secrets.

# --- storage / database ---------------------------------------------------------
# Default (unset): SQLite at backend/var/eagleeye.db and files under backend/var/storage
# EAGLEEYE_DATA_DIR=/var/lib/eagleeye
# PostgreSQL (production-style):
# EAGLEEYE_DATABASE_URL=postgresql+psycopg://eagleeye:CHANGE_ME@localhost:5432/eagleeye
EAGLEEYE_AUTO_MIGRATE=true
EAGLEEYE_ENVIRONMENT=development

# --- HTTP -------------------------------------------------------------------------
# JSON list of allowed browser origins (development also allows any localhost port)
EAGLEEYE_CORS_ORIGINS=["http://localhost:8080","http://localhost:8000"]
# Directory with the Flutter web build that the API serves at "/" (set empty to disable)
# EAGLEEYE_FRONTEND_DIST=../frontend/build/web

# --- uploads ----------------------------------------------------------------------
EAGLEEYE_MAX_IMAGE_MB=25
EAGLEEYE_MAX_PDF_MB=50
EAGLEEYE_MAX_SHEET_MB=10

# --- detector (YOLOv8) --------------------------------------------------------------
# Cabinet-specific weights; falls back to generic COCO weights (no cabinet classes) if missing.
# EAGLEEYE_DETECTOR_WEIGHTS=../models/eagleeye-synth-v1.pt
# EAGLEEYE_DETECTOR_FALLBACK_WEIGHTS=../models/cache/yolov8n.pt
EAGLEEYE_DETECTOR_DEVICE=auto
EAGLEEYE_DETECTOR_CONF=0.35
EAGLEEYE_DETECTOR_IOU=0.5
EAGLEEYE_DETECTOR_TILING=true

# --- OCR ------------------------------------------------------------------------------
# auto = PaddleOCR if it loads, else EasyOCR | paddle | easyocr | none
EAGLEEYE_OCR_ENGINE=auto
EAGLEEYE_OCR_LANGUAGES=["en"]
EAGLEEYE_OCR_GPU=false
# EAGLEEYE_EASYOCR_MODEL_DIR=../models/cache/easyocr
EAGLEEYE_OCR_ALLOW_DOWNLOAD=false
# IEC 81346 reference designations avoid I and O (confused with 1 and 0)
EAGLEEYE_OCR_EXCLUDE_IO=true

# --- misc ------------------------------------------------------------------------------
EAGLEEYE_REVIEWER_IDENTITY=local-demo-reviewer
EAGLEEYE_TEMP_RETENTION_HOURS=24
